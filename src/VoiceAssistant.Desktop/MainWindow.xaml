<Window x:Class="VoiceAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="In-person English Coach" Width="900" Height="760" MinWidth="700" MinHeight="560"
        Closing="Window_Closing" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <Button x:Name="SignInButton" DockPanel.Dock="Right" Content="Sign in with Microsoft" Click="SignIn_Click" Padding="14,7"/>
      <Button x:Name="DeviceCodeButton" DockPanel.Dock="Right" Content="Use device code" Click="DeviceCode_Click"
              Padding="12,7" Margin="0,0,8,0"/>
      <Button x:Name="DemoPreviewButton" DockPanel.Dock="Right" Content="Offline demo preview"
              Click="DemoPreview_Click" Padding="12,7" Margin="0,0,8,0"/>
      <StackPanel>
        <TextBlock Text="In-person English Coach" FontSize="25" FontWeight="SemiBold"/>
        <TextBlock x:Name="AuthStatus" Text="Sign in before using live features." Foreground="#4C596A" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>
    <TabControl Grid.Row="1">
      <TabItem Header="Meeting setup and transcript">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <Border Background="White" BorderBrush="#D8DFE9" BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel>
                <TextBlock Text="Physical microphone" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,10" TextWrapping="Wrap"
                           Text="Select a room microphone. This app does not capture Teams or system playback. Capture starts only after you check participant consent and select Start."/>
                <DockPanel>
                  <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" Margin="8,0,0,0"/>
                  <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" MinHeight="32"
                            AutomationProperties.Name="Physical microphone"/>
                </DockPanel>
                <Button x:Name="MicTestButton" Content="Test microphone locally (3 seconds)"
                        Click="MicTest_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <ProgressBar x:Name="LevelMeter" Minimum="0" Maximum="1" Height="12" Margin="0,9,0,2"/>
                <TextBlock x:Name="LevelText" Text="Input level: idle"/>
                <CheckBox x:Name="ConsentBox" Margin="0,12,0,0">
                  <TextBlock TextWrapping="Wrap" Text="I have told participants and have permission to capture and send this room audio for this session. Audio is streamed only while active and is never saved by this app."/>
                </CheckBox>
                <WrapPanel Margin="0,12,0,0">
                  <Button x:Name="StartButton" Content="Start meeting overlay" Click="Start_Click" Padding="12,7" Margin="0,0,8,0"/>
                  <Button x:Name="StopButton" Content="Stop and release microphone" Click="Stop_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0"/>
                  <Button x:Name="ShowOverlayButton" Content="Show overlay" Click="ShowOverlay_Click" Padding="12,7" Margin="0,0,8,0"/>
                  <CheckBox x:Name="PauseBox" Content="Pause while I speak" IsEnabled="False" VerticalAlignment="Center"
                            Checked="Pause_Changed" Unchecked="Pause_Changed" Margin="8,0"/>
                  <CheckBox x:Name="TopmostBox" Content="Overlay always on top" IsChecked="True"
                            Checked="Topmost_Changed" Unchecked="Topmost_Changed" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock x:Name="StatusText" Text="Stopped — no audio capture" FontWeight="SemiBold" Margin="0,10,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="ErrorText" Foreground="#A31515" TextWrapping="Wrap" Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Assertive"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DFE9" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
              <StackPanel>
                <TextBlock Text="Response context" FontSize="18" FontWeight="SemiBold"/>
                <WrapPanel Margin="0,8,0,0">
                  <StackPanel Width="190" Margin="0,0,12,0">
                    <TextBlock Text="Grounding mode"/>
                    <ComboBox x:Name="ModeBox" SelectedIndex="0" MinHeight="30">
                      <ComboBoxItem Content="Balanced (recommended)" Tag="balanced"/>
                      <ComboBoxItem Content="Always search my materials" Tag="grounded"/>
                      <ComboBoxItem Content="Conversation only" Tag="conversation"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Width="230">
                    <TextBlock Text="Presentation topic (optional)"/>
                    <TextBox x:Name="TopicBox" MaxLength="300" MinHeight="30"/>
                  </StackPanel>
                </WrapPanel>
                <TextBlock Text="Confirmed profile for direct introductions (optional)" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <WrapPanel>
                  <TextBox x:Name="ProfileNameBox" Width="160" MaxLength="100" ToolTip="Your name (optional)" Margin="0,0,6,0"/>
                  <TextBox x:Name="ProfileRoleBox" Width="220" MaxLength="160" ToolTip="Your role (optional)" Margin="0,0,6,0"/>
                  <TextBox x:Name="ProfileProjectBox" Width="250" MaxLength="300" ToolTip="Your project (optional)"/>
                </WrapPanel>
                <CheckBox x:Name="ProfileConfirmBox" Content="These profile details are accurate and I confirm they may be used in answers." Margin="0,6,0,0"/>
                <CheckBox x:Name="KoreanBox" Content="Show Korean meaning and reading guide for completed replies" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#D8DFE9" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,12,0,0">
              <StackPanel>
                <DockPanel>
                  <Button x:Name="PracticeButton" DockPanel.Dock="Right" Content="Open separate practice window"
                          Click="Practice_Click" Padding="12,7"/>
                  <TextBlock Text="English transcript" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="TranscriptBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MinHeight="140" MaxHeight="240" Margin="0,8,0,0" AutomationProperties.Name="Room speech transcript"/>
                <WrapPanel Margin="0,10,0,5">
                  <Button x:Name="RequestButton" Content="Generate reply again" Click="Request_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="CancelButton" Content="Cancel current reply" Click="Cancel_Click" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock Text="Latest answer (streaming)" FontWeight="SemiBold"/>
                <TextBox x:Name="ReplyBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="18" MinHeight="90" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Latest streaming reply"/>
                <TextBlock x:Name="GroundingText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SourcesText" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="KoreanText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="16"/>
                <TextBlock x:Name="ReadingText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#43536A"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="ReadButton" Content="Read answer aloud" Click="Read_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button x:Name="PinButton" Content="Pin reply snapshot" Click="Pin_Click" IsEnabled="False" Margin="0,0,8,0"/>
                  <Button Content="Unpin" Click="Unpin_Click"/>
                </WrapPanel>
                <TextBlock Text="Pinned answer" FontWeight="SemiBold" Margin="0,10,0,4"/>
                <TextBox x:Name="PinnedBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="PinnedSourcesText" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="MaterialsTab" Header="My materials">
        <Grid Margin="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Your Entra-account materials" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,10"
                       Text="Documents are indexed in Azure AI Search under your authenticated account. Only matching owner-authorized sources can ground a reply."/>
            <WrapPanel>
              <Button Content="Refresh list" Click="MaterialsRefresh_Click" Margin="0,0,8,0"/>
              <Button Content="Upload a file" Click="Upload_Click" Margin="0,0,8,0"/>
              <Button Content="Add notes" Click="AddNotes_Click" Margin="0,0,8,0"/>
              <Button Content="Delete selected" Click="DeleteMaterial_Click"/>
            </WrapPanel>
          </StackPanel>
          <ListBox x:Name="MaterialsList" Grid.Row="1" Margin="0,10,0,10" DisplayMemberPath="Title"/>
          <TextBlock x:Name="MaterialsStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="#43536A"/>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
