<Window x:Class="VoiceAssistant.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="English Coach" Width="420" Height="260" MinWidth="320" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="False">
  <Border x:Name="Panel" Background="#E51A2230" BorderBrush="#657386" BorderThickness="1"
          CornerRadius="10" Padding="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" MouseLeftButtonDown="DragPanel">
        <Button DockPanel.Dock="Right" Content="×" Width="28" Height="25" Click="Close_Click" ToolTip="Hide overlay"
                Background="#27384B" Foreground="White" BorderThickness="0"/>
        <TextBlock x:Name="CaptureStatus" Text="MICROPHONE OFF" Foreground="#AFC5D9" FontWeight="Bold"
                   VerticalAlignment="Center" FontSize="11"/>
      </DockPanel>
      <TextBlock x:Name="QuestionText" Grid.Row="1" Text="Waiting for a room question…" TextWrapping="Wrap"
                 Foreground="#E7EDF5" FontSize="13" Margin="0,8,0,5"/>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="AnswerText" Text="No reply yet" TextWrapping="Wrap" Foreground="White"
                   FontSize="20" FontWeight="SemiBold"/>
      </ScrollViewer>
      <TextBlock x:Name="KoreanText" Grid.Row="3" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,4,0,0"/>
      <TextBlock x:Name="ReadingText" Grid.Row="4" TextWrapping="Wrap" Foreground="#D5E0EC" FontSize="11" Margin="0,3,0,0"/>
      <DockPanel Grid.Row="5" Margin="0,7,0,0">
        <Button DockPanel.Dock="Right" Content="+" Width="30" Height="24" Click="Grow_Click"
                Background="#27384B" Foreground="White" BorderThickness="0" ToolTip="Increase overlay size"/>
        <TextBlock x:Name="GroundingText" Foreground="#C5D2E0" Text="Keep answers brief; verify before speaking."
                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <ResizeGrip Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,35,0"
                  Background="#8394A7" Width="16" Height="16" ToolTip="Resize overlay"/>
      <Slider Grid.Row="0" Minimum="55" Maximum="94" Value="90" Width="65" Height="18"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0"
              ValueChanged="Opacity_Changed" ToolTip="Adjust panel background opacity"/>
    </Grid>
  </Border>
</Window>
