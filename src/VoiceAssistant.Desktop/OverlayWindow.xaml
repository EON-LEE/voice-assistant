<Window x:Class="VoiceAssistant.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Coach — Overlay v2" Width="550" Height="860" MinWidth="550" MinHeight="740"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        FontFamily="Segoe UI" Foreground="#EDF2FA">
  <Border x:Name="Panel" Background="#F0141D2B" BorderBrush="#74849B" BorderThickness="1"
          CornerRadius="16">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="마이크 설정 / 내 문서" Click="Settings_Click"/>
        <MenuItem x:Name="StartMenu" Header="라이브 시작 · 마이크 음성을 Azure로 전송 (참여자 허락 필요)" Click="Start_Click"/>
        <MenuItem x:Name="PauseMenu" Header="내가 말할 동안 일시정지" Click="Pause_Click"/>
        <MenuItem x:Name="RetryMenu" Header="추천 답변 다시 생성" Click="Retry_Click"/>
        <MenuItem x:Name="TranslationMenu" Header="한국어 번역 재시도" Click="Translation_Click"/>
        <MenuItem x:Name="StopMenu" Header="회의 종료 / 마이크 해제" Click="Stop_Click"/>
        <Separator/>
        <MenuItem Header="프로그램 종료" Click="Exit_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="22,14"
              MouseLeftButtonDown="DragPanel">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="OVERLAY v2" Foreground="#A5B0C2" FontSize="10" DockPanel.Dock="Right"/>
            <Ellipse x:Name="CaptureDot" Width="6" Height="6" Fill="#84DCAF" Margin="0,0,7,0"
                     VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock x:Name="CaptureStatus" Text="마이크 꺼짐 · 우클릭으로 시작"
                       FontSize="12" Foreground="#B4E2C8"/>
          </DockPanel>
          <TextBlock x:Name="SessionError" Foreground="#FFB5B5" TextWrapping="Wrap"
                     FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="1" Padding="22,14" BorderBrush="#1BFFFFFF" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBlock Text="들은 대화" Foreground="#A6B5CC" FontSize="11" FontWeight="SemiBold"/>
          <ScrollViewer x:Name="ConversationScroll" MaxHeight="115" VerticalScrollBarVisibility="Auto"
                        Margin="0,9,0,0" AutomationProperties.Name="Recognized conversation, not AI suggestions">
            <StackPanel x:Name="ConversationPanel">
              <TextBlock x:Name="QuestionText" Text="영어 대화를 기다리고 있어요."
                         TextWrapping="Wrap" FontSize="15"/>
            </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="ContextText" Text="이전 대화 맥락 기본 연결 · 추천은 실제 발화로 기억하지 않음"
                     TextWrapping="Wrap" Foreground="#9DB5D4" FontSize="11" Margin="0,9,0,0"/>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="SuggestionsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,14"
                    AutomationProperties.Name="Suggested answers and Korean meanings">
        <StackPanel>
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="#55315845" BorderBrush="#44729E7D"
                    BorderThickness="1" CornerRadius="12" Padding="8,3">
              <TextBlock x:Name="GroundingBadge" Text="맥락 연결" Foreground="#B6D2C3" FontSize="10"/>
            </Border>
            <TextBlock Text="내가 말할 추천 답변" Foreground="#A9C9FF" FontSize="12" FontWeight="Bold"
                       VerticalAlignment="Center"/>
          </DockPanel>
          <Border Background="#12739CDE" BorderBrush="#359ABBEE" BorderThickness="1"
                  CornerRadius="11" Padding="16,15" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="우선 추천" DockPanel.Dock="Right" Foreground="#9FB1CB" FontSize="10"/>
                <TextBlock x:Name="PrimaryLabel" Text="01 · 바로 답하기" Foreground="#B7D2FF" FontSize="11"
                           FontWeight="SemiBold"/>
              </DockPanel>
              <TextBlock x:Name="AnswerText" Text="대화가 인식되면 추천 답변이 여기에 표시됩니다."
                         FontSize="23" LineHeight="33" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,12"/>
              <Border BorderBrush="#30A1C5FF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="한국어 뜻" Foreground="#AEC8EF" FontSize="11"/>
                  <TextBlock x:Name="KoreanText" Text="영어 추천 답변의 한국어 뜻이 함께 표시됩니다."
                             Foreground="#DFEBFF" FontSize="14" LineHeight="24" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="질문에 짧게 답하는 우선 추천 표현" Foreground="#9BAFCB" FontSize="11"
                         Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <Border x:Name="AlternativeCard" Visibility="Collapsed" Background="#08FFFFFF"
                  BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="11" Padding="16,15" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="대안 표현" DockPanel.Dock="Right" Foreground="#9FB1CB" FontSize="10"/>
                <TextBlock Text="02 · 다른 표현으로 답하기" Foreground="#B7D2FF" FontSize="11"
                           FontWeight="SemiBold"/>
              </DockPanel>
              <TextBlock x:Name="AlternativeText" FontSize="23" LineHeight="33" FontWeight="SemiBold"
                         TextWrapping="Wrap" Margin="0,10,0,12"/>
              <Border BorderBrush="#30A1C5FF" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <StackPanel>
                  <TextBlock Text="한국어 뜻" Foreground="#AEC8EF" FontSize="11"/>
                  <TextBlock x:Name="AlternativeKoreanText" Foreground="#DFEBFF" FontSize="14" LineHeight="24"
                             TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>
              <TextBlock Text="같은 질문에 답하는 대안 표현" Foreground="#9BAFCB" FontSize="11"
                         Margin="0,9,0,0"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="ContinuityText" TextWrapping="Wrap" Foreground="#9BAEC9" FontSize="10" Margin="0,12,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="3" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="22,12">
        <StackPanel>
          <TextBlock x:Name="GroundingText" Text="근거 상태는 답변 완료 후 표시됩니다."
                     Foreground="#9EB2CE" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock x:Name="SourcesText" Foreground="#C1CFE2" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
