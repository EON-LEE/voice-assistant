<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="..\VoiceAssistant.Audio\VoiceAssistant.Audio.csproj" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Git-ignored deployment values; copied next to the app only when the developer has created the file. -->
    <None Update="appsettings.local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
