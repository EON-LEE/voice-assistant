<Window x:Class="VoiceAssistant.Desktop.PracticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="English conversation practice" Width="1040" Height="820" MinWidth="780" MinHeight="600"
        Closing="Window_Closing" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" x:Name="StopButton" Content="Stop round" Click="Stop_Click" IsEnabled="False"
              Padding="12,7"/>
      <StackPanel>
        <TextBlock Text="English conversation practice" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusText" Text="Set up a scenario. Nothing is captured until you start."
                   Foreground="#4C596A" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" BorderBrush="#D8DFE9" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Practice setup" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Scenario" Margin="0,10,0,3"/>
            <ComboBox x:Name="ScenarioBox" SelectedIndex="0" MinHeight="30">
              <ComboBoxItem Content="Sales conversation" Tag="sales"/>
              <ComboBoxItem Content="Job interview" Tag="interview"/>
              <ComboBoxItem Content="Presentation" Tag="presentation"/>
              <ComboBoxItem Content="Custom role-play" Tag="custom"/>
            </ComboBox>
            <TextBlock Text="Custom description (required for custom)" Margin="0,8,0,3"/>
            <TextBox x:Name="DescriptionBox" MaxLength="400" TextWrapping="Wrap" MinHeight="50"/>
            <TextBlock Text="Difficulty" Margin="0,8,0,3"/>
            <ComboBox x:Name="DifficultyBox" SelectedIndex="1" MinHeight="30">
              <ComboBoxItem Content="1 · Easy" Tag="1"/><ComboBoxItem Content="2 · Medium" Tag="2"/><ComboBoxItem Content="3 · Challenging" Tag="3"/>
            </ComboBox>
            <TextBlock Text="Topic (optional)" Margin="0,8,0,3"/>
            <TextBox x:Name="TopicBox" MaxLength="300" MinHeight="30"/>
            <TextBlock Text="Questions (1–12)" Margin="0,8,0,3"/>
            <ComboBox x:Name="CountBox" SelectedIndex="2" MinHeight="30">
              <ComboBoxItem Content="1" Tag="1"/><ComboBoxItem Content="3" Tag="3"/><ComboBoxItem Content="5" Tag="5"/>
              <ComboBoxItem Content="8" Tag="8"/><ComboBoxItem Content="12" Tag="12"/>
            </ComboBox>
            <CheckBox x:Name="MaterialsBox" Content="Use my uploaded materials (Azure AI Search)"
                      IsChecked="True" Margin="0,10,0,0">
              <CheckBox.ToolTip>Uses materials uploaded by the same signed-in account. Requires internet and Entra sign-in.</CheckBox.ToolTip>
            </CheckBox>
            <TextBlock Text="Personal-material practice uses Azure and requires sign-in. Offline preview shows fixed UI samples, not your uploaded documents."
                       TextWrapping="Wrap" Foreground="#4C596A" Margin="0,6,0,0"/>
            <CheckBox x:Name="ConsentBox" Margin="0,12,0,0">
              <TextBlock TextWrapping="Wrap" Text="I consent to capture my selected microphone only while answering and to send recognized speech to the coach. No audio is saved by this app."/>
            </CheckBox>
            <TextBlock x:Name="MicText" Text="Select a microphone" Margin="0,10,0,3"/>
            <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" MinHeight="30"/>
            <Button x:Name="RefreshButton" Content="Refresh microphones" Click="Refresh_Click" Margin="0,6,0,0"/>
            <Button x:Name="MicTestButton" Content="Test microphone locally (3 seconds)" Click="MicTest_Click"
                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
            <ProgressBar x:Name="LevelMeter" Minimum="0" Maximum="1" Height="10" Margin="0,8,0,2"/>
            <TextBlock x:Name="LevelText" Text="Input level: idle" FontSize="12"/>
            <TextBlock x:Name="AuthText" TextWrapping="Wrap" Foreground="#4C596A" Margin="0,10,0,0"/>
            <Button x:Name="StartButton" Content="Start practice" Click="Start_Click" Padding="12,8" Margin="0,12,0,0"/>
            <TextBlock x:Name="ErrorText" Foreground="#A31515" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Assertive"/>
            <Button x:Name="RetryButton" Content="Retry last request" Click="Retry_Click" Visibility="Collapsed" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Background="White" BorderBrush="#D8DFE9" BorderThickness="1" CornerRadius="8" Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <DockPanel>
              <Button x:Name="ListenButton" DockPanel.Dock="Right" Content="Listen to question" Click="Listen_Click" IsEnabled="False"/>
              <TextBlock Text="Conversation" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="QuestionText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,6"/>
            <TextBlock x:Name="QuestionKoText" FontSize="18" TextWrapping="Wrap" Foreground="#4C596A"/>
            <TextBlock x:Name="GroundingText" TextWrapping="Wrap" Foreground="#43536A" Margin="0,8,0,0"/>
            <TextBlock x:Name="SourceText" TextWrapping="Wrap" Foreground="#43536A" Margin="0,3,0,0"/>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="AnswerButton" Content="Answer by voice" Click="Answer_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0"/>
              <Button x:Name="DoneButton" Content="Done with final answer" Click="Done_Click" IsEnabled="False" Padding="12,7" Margin="0,0,8,0"/>
              <Button x:Name="SkipButton" Content="Skip this question" Click="Skip_Click" IsEnabled="False" Padding="12,7"/>
            </WrapPanel>
            <TextBlock Text="Recognition is shown below; only finalized text can be submitted as an answer."
                       TextWrapping="Wrap" Foreground="#4C596A" Margin="0,10,0,5"/>
            <TextBlock x:Name="PartialText" TextWrapping="Wrap" Foreground="#657386" FontStyle="Italic"/>
            <TextBox x:Name="AnswerText" IsReadOnly="True" TextWrapping="Wrap" FontSize="18" MinHeight="55"
                     MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
            <Button x:Name="HintButton" Content="Suggest a reply (optional)" Click="Hint_Click" IsEnabled="False"
                    HorizontalAlignment="Left" Margin="0,10,0,0"/>
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock x:Name="PronunciationText" TextWrapping="Wrap" Foreground="#43536A" Margin="0,4,0,0"/>
            <TextBlock x:Name="RoundSummaryText" TextWrapping="Wrap" FontSize="17" Margin="0,16,0,0"/>
            <Button x:Name="NextButton" Content="Next question" Click="Next_Click" IsEnabled="False"
                    HorizontalAlignment="Left" Padding="12,7" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
